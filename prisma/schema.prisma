// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  OWNER
  MANAGER
  STAFF
}

enum StaffStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum SubscriptionPlanCode {
  STARTER
  GROWTH
  PRO
  CUSTOM
}

enum StoreSubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum MemberGender {
  UNKNOWN
  MALE
  FEMALE
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum MemberPointsChangeType {
  INCREASE
  DECREASE
}

enum MemberPointsSource {
  purchase_bonus
  deduct_payment
  admin_adjust
  expire
}

enum MemberBeanSource {
  promo_reward
  deduct_payment
  withdrawal
  admin_adjust
}

enum MemberRechargeChannel {
  wechat
  alipay
  card
}

enum EmployeeStatus {
  active
  resigned
}

enum EmployeeGender {
  male
  female
  unset
}

enum EmployeeLeaveType {
  personal
  sick
  annual
  marriage
  other
}

enum EmployeeShiftType {
  morning
  nine_to_six
  middle
  late
  full
  custom
}

enum EmployeePayrollStatus {
  draft
  confirmed
}

enum StoreSubAccountRole {
  cashier
  finance
  manager
}

enum StoreSubAccountStatus {
  active
  inactive
  disabled
}

enum HandoverMode {
  self_main_account
  sub_account
}

enum HandoverStatus {
  pending
  completed
  cancelled
}

enum PartnerAccountStatus {
  pending
  reviewing
  approved
  rejected
}

enum PartnerIntention {
  agent
  invest
  resource
  other
}

enum WithdrawalAccountType {
  wechat
  alipay
  bank
}

enum PartnerWithdrawalStatus {
  pending
  approved
  paid
  rejected
}

enum MembershipPlanCycle {
  monthly
  quarterly
  yearly
  lifetime
}

enum MembershipPlanSettingId {
  monthly
  quarterly
  yearly
  lifetime
}

enum MembershipOrderStatus {
  pending
  paid
  failed
  refunded
}

enum MembershipPaymentChannel {
  wechat
}

enum SalesPaymentMethod {
  cash
  wechat
  alipay
  card
}

enum SalesCalcMode {
  profit
  business
}

enum FinanceCashFlowDirection {
  income
  expense
}

enum FinanceCashFlowCategory {
  sales
  refund
  transfer_in
  other_income
  purchase
  rent
  utilities
  salary
  marketing
  tax
  transfer_out
  other_expense
}

enum FinanceCashFlowPayment {
  cash
  wechat
  alipay
  card
  bank
  other
}

enum FinanceAccountType {
  receivable
  payable
}

enum FinanceAccountStatus {
  pending
  partial
  settled
  overdue
}

enum FinanceAccountCategory {
  sales_credit
  advance_paid
  supplier_debt
  loan
  deposit
  other
}

enum FinanceReconciliationStatus {
  draft
  confirmed
  discrepancy
  adjusted
}

enum FinanceReconciliationType {
  daily
  weekly
  monthly
  payment
  supplier
  custom
}

enum FinancePaymentChannel {
  cash
  wechat
  alipay
  card
  bank
  all
}

enum MarketingCustomerTier {
  regular
  silver
  gold
  diamond
}

enum MarketingRechargeType {
  recharge
  gift
  refund
}

enum MarketingPayType {
  balance
  cash
  wechat
  alipay
  mixed
}

enum MarketingPointsChangeType {
  earn
  spend
  expire
  gift
}

enum MarketingPromotionType {
  discount
  reduce
  recharge_gift
  free
  points_2x
}

enum InventoryAdjustType {
  restock
  damage
  manual
  sale
}

enum CostType {
  fixed
  variable
}

enum CostCategory {
  rent
  salary
  insurance
  provident_fund
  utilities
  purchase
  equipment
  marketing
  packaging
  other
}

enum CostSourceType {
  manual
  purchase
  payroll_salary
  payroll_insurance
  payroll_provident_fund
}

enum SpaceStatus {
  idle
  occupied
  reserved
  cleaning
}

enum SpaceReservationStatus {
  pending
  fulfilled
  cancelled
}

enum SpaceSessionStatus {
  active
  settled
}

enum SpaceBillingMode {
  timed
  items
  mixed
  countdown
}

model User {
  id              Int      @id @default(autoincrement())
  email           String   @unique
  password        String
  name            String?
  avatar          String?
  realName        String?  @map("real_name")
  idNumber        String?  @unique @map("id_number")
  store           Store?
  staffMembership Staff?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Store {
  id                     Int                           @id @default(autoincrement())
  name                   String
  contactName            String?                       @map("contact_name")
  contactPhone           String?                       @map("contact_phone")
  address                String?
  ownerId                Int                           @unique @map("owner_id")
  owner                  User                          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  maxAccountSeats        Int                           @default(1) @map("max_account_seats")
  subscription           StoreSubscription?
  partners               StorePartner[]
  membershipProfile      StoreMembershipProfile?
  membershipOrders       StoreMembershipOrder[]
  membershipPointsLogs   StoreMembershipPointsLog[]
  membershipPromoRecords StoreMembershipPromoRecord[]
  partnerApplications    StorePartnerApplication[]
  partnerBeanLogs        StorePartnerBeanLog[]
  staffs                 Staff[]
  members                Member[]
  memberPointsLogs       MemberPointsLog[]
  memberBeanLogs         MemberBeanLog[]
  memberRechargeLogs     MemberRechargeLog[]
  partnerWithdrawals     PartnerWithdrawal[]
  financeCashFlows       FinanceCashFlowRecord[]
  financeAccounts        FinanceAccountRecord[]
  financeReconciles      FinanceReconciliationRecord[]
  productCategories      ProductCategory[]
  products               Product[]
  suppliers              Supplier[]
  purchaseOrders         PurchaseOrder[]
  purchaseOrderItems     PurchaseOrderItem[]
  inventoryAdjustments   InventoryAdjustmentLog[]
  salesOrders            SaleOrder[]
  salesOrderItems        SaleOrderItem[]
  employeeDepartments    EmployeeDepartment[]
  employeePositions      EmployeePosition[]
  employees              Employee[]
  employeeLeaves         EmployeeLeave[]
  employeeShiftDefinitions EmployeeShiftDefinition[]
  employeeShifts         EmployeeShift[]
  employeePayrolls       EmployeePayroll[]
  costRecords            CostRecord[]
  marketingCustomers     MarketingCustomer[]
  marketingRecharges     MarketingRecharge[]
  marketingConsumptions  MarketingConsumption[]
  marketingPointsRecords MarketingPointsRecord[]
  marketingPromotions    MarketingPromotion[]
  subAccounts            StoreSubAccount[]
  subAccountQuotaAudits  StoreSubAccountQuotaAudit[]
  handoverRecords        StoreHandoverRecord[]
  handoverAdditionalItems StoreHandoverAdditionalItem[]
  spaceTypes             SpaceType[]
  spaceZones             SpaceZone[]
  spaces                 Space[]
  spaceReservations      SpaceReservation[]
  spaceSessions          SpaceSession[]
  createdAt              DateTime                      @default(now()) @map("created_at")
  updatedAt              DateTime                      @updatedAt @map("updated_at")

  @@index([ownerId, updatedAt])
  @@index([name])
  @@index([contactName])
  @@map("stores")
}

model SpaceType {
  id        Int      @id @default(autoincrement())
  storeId   Int      @map("store_id")
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  spaces    Space[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([storeId, name])
  @@index([storeId, updatedAt])
  @@map("space_types")
}

model SpaceZone {
  id        Int      @id @default(autoincrement())
  storeId   Int      @map("store_id")
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  spaces    Space[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([storeId, name])
  @@index([storeId, updatedAt])
  @@map("space_zones")
}

model Space {
  id              Int                @id @default(autoincrement())
  storeId         Int                @map("store_id")
  store           Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  typeId          Int                @map("type_id")
  type            SpaceType          @relation(fields: [typeId], references: [id], onDelete: Restrict)
  zoneId          Int?               @map("zone_id")
  zone            SpaceZone?         @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  name            String
  capacity        Int?
  enableDirtyRoom Boolean            @default(false) @map("enable_dirty_room")
  autoCheckout    Boolean            @default(false) @map("auto_checkout")
  status          SpaceStatus        @default(idle)
  reservations    SpaceReservation[]
  sessions        SpaceSession[]
  sortOrder       Int                @default(1) @map("sort_order")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@unique([storeId, name])
  @@index([storeId, status, sortOrder])
  @@index([storeId, typeId, sortOrder])
  @@index([storeId, zoneId, sortOrder])
  @@map("spaces")
}

model SpaceReservation {
  id            Int                    @id @default(autoincrement())
  storeId       Int                    @map("store_id")
  store         Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  spaceId       Int                    @map("space_id")
  space         Space                  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  guestName     String                 @map("guest_name")
  phone         String?
  reservedAt    DateTime               @map("reserved_at")
  reservedEndAt DateTime?              @map("reserved_end_at")
  guestCount    Int?                   @map("guest_count")
  note          String?
  status        SpaceReservationStatus @default(pending)
  session       SpaceSession?
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  @@index([spaceId, status, reservedAt])
  @@index([storeId, status, reservedAt])
  @@index([storeId, createdAt])
  @@map("space_reservations")
}

model SpaceSession {
  id                   Int                 @id @default(autoincrement())
  storeId              Int                 @map("store_id")
  store                Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  spaceId              Int                 @map("space_id")
  space                Space               @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  reservationId        Int?                @unique @map("reservation_id")
  reservation          SpaceReservation?   @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  saleOrderId          Int?                @unique @map("sale_order_id")
  saleOrder            SaleOrder?          @relation(fields: [saleOrderId], references: [id], onDelete: SetNull)
  guestName            String?             @map("guest_name")
  guestPhone           String?             @map("guest_phone")
  guestCount           Int?                @map("guest_count")
  startTime            DateTime            @map("start_time")
  endTime              DateTime?           @map("end_time")
  billingMode          SpaceBillingMode    @map("billing_mode")
  hourlyRate           Decimal?            @map("hourly_rate") @db.Decimal(12, 2)
  timeCost             Decimal?            @map("time_cost") @db.Decimal(12, 2)
  countdownMinutes     Int?                @map("countdown_minutes")
  autoCheckout         Boolean?            @map("auto_checkout")
  prepaidPaymentMethod SalesPaymentMethod? @map("prepaid_payment_method")
  prepaidGrouponCode   String?             @map("prepaid_groupon_code")
  prepaidNote          String?             @map("prepaid_note")
  prepaidAmount        Decimal?            @map("prepaid_amount") @db.Decimal(12, 2)
  items                Json                @default("[]")
  itemsCost            Decimal             @default(0) @map("items_cost") @db.Decimal(12, 2)
  renewRecords         Json                @default("[]") @map("renew_records")
  status               SpaceSessionStatus  @default(active)
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  @@index([spaceId, status, startTime])
  @@index([storeId, status, startTime])
  @@index([storeId, endTime])
  @@map("space_sessions")
}

model StoreSubscription {
  id              Int                     @id @default(autoincrement())
  storeId         Int                     @unique @map("store_id")
  store           Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  planCode        SubscriptionPlanCode    @map("plan_code")
  planName        String                  @map("plan_name")
  status          StoreSubscriptionStatus @default(ACTIVE)
  maxAccountSeats Int                     @map("max_account_seats")
  startsAt        DateTime                @default(now()) @map("starts_at")
  expiresAt       DateTime?               @map("expires_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  @@index([status])
  @@map("store_subscriptions")
}

model Staff {
  id                   Int                           @id @default(autoincrement())
  storeId              Int                           @map("store_id")
  store                Store                         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId               Int?                          @unique @map("user_id")
  user                 User?                         @relation(fields: [userId], references: [id], onDelete: SetNull)
  email                String                        @unique
  name                 String
  phone                String?
  role                 StaffRole                     @default(STAFF)
  permissions          String[]                      @default([])
  status               StaffStatus                   @default(INVITED)
  isSeatActive         Boolean                       @default(false) @map("is_seat_active")
  isActive             Boolean                       @default(true) @map("is_active")
  memberPointsLogs     MemberPointsLog[]             @relation("MemberPointsLogsOperator")
  memberBeanLogs       MemberBeanLog[]               @relation("MemberBeanLogsOperator")
  memberRechargeLogs   MemberRechargeLog[]           @relation("MemberRechargeLogsOperator")
  partnerWithdrawals   PartnerWithdrawal[]           @relation("PartnerWithdrawalsOperator")
  initiatedHandovers   StoreHandoverRecord[]         @relation("HandoverActorStaff")
  financeCashFlows     FinanceCashFlowRecord[]       @relation("FinanceCashFlowOperator")
  financeAccounts      FinanceAccountRecord[]        @relation("FinanceAccountOperator")
  financeReconciles    FinanceReconciliationRecord[] @relation("FinanceReconciliationOperator")
  purchaseOrders       PurchaseOrder[]               @relation("PurchaseOrderOperator")
  inventoryAdjustments InventoryAdjustmentLog[]      @relation("InventoryAdjustmentOperator")
  salesOrders          SaleOrder[]                   @relation("SaleOrderOperator")
  costRecords          CostRecord[]                  @relation("CostRecordOperator")
  employeeProfile      Employee?                     @relation("StaffEmployeeProfile")
  createdAt            DateTime                      @default(now()) @map("created_at")
  updatedAt            DateTime                      @updatedAt @map("updated_at")

  @@index([storeId])
  @@index([storeId, updatedAt])
  @@index([storeId, status, isSeatActive, isActive])
  @@index([storeId, status, role, updatedAt])
  @@index([userId, status, isActive])
  @@index([email, status, isActive])
  @@map("staffs")
}

model Member {
  id                 Int                 @id @default(autoincrement())
  storeId            Int                 @map("store_id")
  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name               String
  phone              String?
  gender             MemberGender        @default(UNKNOWN)
  level              String              @default("free")
  tags               String[]            @default([])
  note               String?
  birthday           DateTime?
  lastConsumeAt      DateTime?           @map("last_consume_at")
  totalConsumeAmount Decimal             @default(0) @map("total_consume_amount") @db.Decimal(12, 2)
  totalConsumeCount  Int                 @default(0) @map("total_consume_count")
  points             Int                 @default(0)
  totalPointsEarned  Int                 @default(0) @map("total_points_earned")
  beanBalance        Int                 @default(0) @map("bean_balance")
  isPartner          Boolean             @default(false) @map("is_partner")
  partnerLevel       String?             @map("partner_level")
  totalRecharged     Int                 @default(0) @map("total_recharged")
  rechargeCount      Int                 @default(0) @map("recharge_count")
  invitedCount       Int                 @default(0) @map("invited_count")
  bannedReason       String?             @map("banned_reason")
  status             MemberStatus        @default(ACTIVE)
  memberPointsLogs   MemberPointsLog[]
  memberBeanLogs     MemberBeanLog[]
  memberRechargeLogs MemberRechargeLog[]
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@unique([storeId, phone])
  @@index([storeId, updatedAt])
  @@index([storeId, status, updatedAt])
  @@index([storeId, level, updatedAt])
  @@index([storeId, isPartner, updatedAt])
  @@index([phone])
  @@map("members")
}

model MemberPointsLog {
  id              Int                    @id @default(autoincrement())
  memberId        Int                    @map("member_id")
  member          Member                 @relation(fields: [memberId], references: [id], onDelete: Cascade)
  storeId         Int                    @map("store_id")
  store           Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  operatorStaffId Int?                   @map("operator_staff_id")
  operatorStaff   Staff?                 @relation("MemberPointsLogsOperator", fields: [operatorStaffId], references: [id], onDelete: SetNull)
  changeType      MemberPointsChangeType @map("change_type")
  source          MemberPointsSource     @default(admin_adjust)
  changeAmount    Int                    @map("change_amount")
  beforePoints    Int                    @map("before_points")
  afterPoints     Int                    @map("after_points")
  reason          String
  remark          String?
  expiresAt       DateTime?              @map("expires_at")
  createdAt       DateTime               @default(now()) @map("created_at")

  @@index([memberId, createdAt])
  @@index([storeId, createdAt])
  @@index([operatorStaffId, createdAt])
  @@index([source, createdAt])
  @@map("member_points_logs")
}

model MemberBeanLog {
  id              Int              @id @default(autoincrement())
  memberId        Int              @map("member_id")
  member          Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  storeId         Int              @map("store_id")
  store           Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  operatorStaffId Int?             @map("operator_staff_id")
  operatorStaff   Staff?           @relation("MemberBeanLogsOperator", fields: [operatorStaffId], references: [id], onDelete: SetNull)
  source          MemberBeanSource
  changeAmount    Int              @map("change_amount")
  beforeBalance   Int              @map("before_balance")
  afterBalance    Int              @map("after_balance")
  reason          String
  relatedPromoId  String?          @map("related_promo_id")
  relatedUser     String?          @map("related_user")
  createdAt       DateTime         @default(now()) @map("created_at")

  @@index([memberId, createdAt])
  @@index([storeId, createdAt])
  @@index([operatorStaffId, createdAt])
  @@index([source, createdAt])
  @@map("member_bean_logs")
}

model MemberRechargeLog {
  id              Int                   @id @default(autoincrement())
  memberId        Int                   @map("member_id")
  member          Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  storeId         Int                   @map("store_id")
  store           Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  operatorStaffId Int?                  @map("operator_staff_id")
  operatorStaff   Staff?                @relation("MemberRechargeLogsOperator", fields: [operatorStaffId], references: [id], onDelete: SetNull)
  planName        String                @map("plan_name")
  amount          Int
  pointsAwarded   Int                   @default(0) @map("points_awarded")
  channel         MemberRechargeChannel
  createdAt       DateTime              @default(now()) @map("created_at")

  @@index([memberId, createdAt])
  @@index([storeId, createdAt])
  @@index([operatorStaffId, createdAt])
  @@map("member_recharge_logs")
}

model MembershipPlanSetting {
  id             Int                     @id @default(autoincrement())
  planId         MembershipPlanSettingId @unique @map("plan_id")
  planName       String                  @map("plan_name")
  price          Int
  originalPrice  Int?                    @map("original_price")
  durationMonths Int?                    @map("duration_months")
  validDays      Int?                    @map("valid_days")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  @@map("membership_plan_settings")
}

model StoreMembershipProfile {
  id              Int                        @id @default(autoincrement())
  storeId         Int                        @unique @map("store_id")
  store           Store                      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  currentPlanId   MembershipPlanCycle?       @map("current_plan_id")
  startsAt        DateTime?                  @map("starts_at")
  expiresAt       DateTime?                  @map("expires_at")
  totalPoints     Int                        @default(0) @map("total_points")
  availablePoints Int                        @default(0) @map("available_points")
  subAccountQuota Int                        @default(0) @map("sub_account_quota")
  orders          StoreMembershipOrder[]
  pointsLogs      StoreMembershipPointsLog[]
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("store_membership_profiles")
}

model StoreSubAccountQuotaAudit {
  id             Int      @id @default(autoincrement())
  storeId        Int      @map("store_id")
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  oldQuota       Int      @map("old_quota")
  newQuota       Int      @map("new_quota")
  operatorUserId Int?     @map("operator_user_id")
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([storeId, createdAt])
  @@map("store_sub_account_quota_audits")
}

model StoreSubAccount {
  id             Int                   @id @default(autoincrement())
  storeId        Int                   @map("store_id")
  store          Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  employeeId     Int?                  @unique @map("employee_id")
  employee       Employee?             @relation("EmployeeSubAccounts", fields: [employeeId], references: [id], onDelete: SetNull)
  slotIndex      Int                   @map("slot_index")
  role           StoreSubAccountRole
  status         StoreSubAccountStatus @default(active)
  isAssigned     Boolean               @default(false) @map("is_assigned")
  canUseHandover Boolean               @default(true) @map("can_use_handover")
  canAccessHome  Boolean               @default(true) @map("can_access_home")
  assignedAt     DateTime?             @map("assigned_at")
  handoverFrom   StoreHandoverRecord[] @relation("HandoverFromSubAccount")
  handoverTo     StoreHandoverRecord[] @relation("HandoverToSubAccount")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  @@unique([storeId, slotIndex])
  @@index([storeId, role, status])
  @@index([storeId, isAssigned, status])
  @@map("store_sub_accounts")
}

model StoreHandoverRecord {
  id               Int              @id @default(autoincrement())
  storeId          Int              @map("store_id")
  store            Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  fromEmployeeId   Int?             @map("from_employee_id")
  fromEmployee     Employee?        @relation("HandoverFromEmployee", fields: [fromEmployeeId], references: [id], onDelete: SetNull)
  toEmployeeId     Int?             @map("to_employee_id")
  toEmployee       Employee?        @relation("HandoverToEmployee", fields: [toEmployeeId], references: [id], onDelete: SetNull)
  fromSubAccountId Int?             @map("from_sub_account_id")
  fromSubAccount   StoreSubAccount? @relation("HandoverFromSubAccount", fields: [fromSubAccountId], references: [id], onDelete: SetNull)
  toSubAccountId   Int?             @map("to_sub_account_id")
  toSubAccount     StoreSubAccount? @relation("HandoverToSubAccount", fields: [toSubAccountId], references: [id], onDelete: SetNull)
  actorStaffId     Int?             @map("actor_staff_id")
  actorStaff       Staff?           @relation("HandoverActorStaff", fields: [actorStaffId], references: [id], onDelete: SetNull)
  handoverMode     HandoverMode     @map("handover_mode")
  status           HandoverStatus   @default(pending)
  handoverAt       DateTime?                    @map("handover_at")
  note             String?
  reason           String?
  additionalValues StoreHandoverAdditionalValue[]
  createdAt        DateTime                     @default(now()) @map("created_at")
  updatedAt        DateTime                     @updatedAt @map("updated_at")

  @@index([storeId, status, createdAt])
  @@index([fromEmployeeId, createdAt])
  @@index([toEmployeeId, createdAt])
  @@map("store_handover_records")
}

model StoreHandoverAdditionalItem {
  id        Int                          @id @default(autoincrement())
  storeId   Int                          @map("store_id")
  store      Store                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  values    StoreHandoverAdditionalValue[]
  createdAt DateTime                     @default(now()) @map("created_at")
