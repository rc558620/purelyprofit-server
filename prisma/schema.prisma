  afterStock      Int                 @map("after_stock")
  delta           Int
  adjustType      InventoryAdjustType @map("adjust_type")
  note            String?
  createdAt       DateTime            @default(now()) @map("created_at")

  @@index([storeId, createdAt])
  @@index([productId, createdAt])
  @@index([purchaseOrderId, createdAt])
  @@index([saleOrderId, createdAt])
  @@index([operatorStaffId, createdAt])
  @@map("inventory_adjustment_logs")
}

model CostRecord {
  id              Int              @id @default(autoincrement())
  storeId         Int              @map("store_id")
  store           Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  operatorStaffId Int?             @map("operator_staff_id")
  operatorStaff   Staff?           @relation("CostRecordOperator", fields: [operatorStaffId], references: [id], onDelete: SetNull)
  purchaseOrderId Int?             @map("purchase_order_id")
  purchaseOrder   PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  payrollId       Int?             @map("payroll_id")
  payroll         EmployeePayroll? @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  sourceType      CostSourceType   @map("source_type")
  title           String
  type            CostType
  category        CostCategory
  amount          Decimal          @db.Decimal(12, 2)
  note            String?
  date            DateTime
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@unique([storeId, sourceType, purchaseOrderId])
  @@unique([storeId, sourceType, payrollId])
  @@index([storeId, date])
  @@index([storeId, type, date])
  @@index([storeId, category, date])
  @@index([operatorStaffId, createdAt])
  @@map("cost_records")
}

model SaleOrder {
  id              Int                      @id @default(autoincrement())
  storeId         Int                      @map("store_id")
  store           Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  operatorStaffId Int?                     @map("operator_staff_id")
  operatorStaff   Staff?                   @relation("SaleOrderOperator", fields: [operatorStaffId], references: [id], onDelete: SetNull)
  orderNo         String                   @map("order_no")
  totalRevenue    Decimal                  @map("total_revenue") @db.Decimal(12, 2)
  totalProfit     Decimal                  @map("total_profit") @db.Decimal(12, 2)
  totalQuantity   Int                      @map("total_quantity")
  paymentMethod   SalesPaymentMethod       @map("payment_method")
  calcMode        SalesCalcMode            @default(business) @map("calc_mode")
  note            String?
  date            DateTime
  items           SaleOrderItem[]
  inventoryLogs   InventoryAdjustmentLog[]
  cashFlowRecord  FinanceCashFlowRecord?
  spaceSession    SpaceSession?
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  @@unique([storeId, orderNo])
  @@index([storeId, date])
  @@index([operatorStaffId, createdAt])
  @@map("sale_orders")
}

model SaleOrderItem {
  id           Int       @id @default(autoincrement())
  orderId      Int       @map("order_id")
  order        SaleOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeId      Int       @map("store_id")
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId    Int?      @map("product_id")
  product      Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String    @map("product_name")
  categoryName String    @map("category_name")
  salePrice    Decimal   @map("sale_price") @db.Decimal(12, 2)
  profit       Decimal   @db.Decimal(12, 2)
  quantity     Int
  image        String?
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@index([storeId, createdAt])
  @@index([productId, createdAt])
  @@index([categoryName, createdAt])
  @@map("sale_order_items")
}

// ─── 营销中心 ─────────────────────────────────────────────────────────

/// 营销顾客档案（商家自己的客人，与平台会员 Member 无关）
model MarketingCustomer {
  id            Int                     @id @default(autoincrement())
  storeId       Int                     @map("store_id")
  store         Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// 昵称
  name          String
  /// 手机号（明文存储，展示层脱敏）
  phone         String?
  /// 头像 URL（可选）
  avatar        String?
  /// 会员等级（根据 totalSpent 计算，实时同步）
  tier          MarketingCustomerTier   @default(regular)
  /// 储值余额（分）
  balance       Int                     @default(0)
  /// 积分余额
  points        Int                     @default(0)
  /// 累计消费金额（分，流水口径）
  totalSpent    Int                     @default(0) @map("total_spent")
  /// 累计消费次数
  visitCount    Int                     @default(0) @map("visit_count")
  /// 最后消费时间
  lastVisitAt   DateTime?               @map("last_visit_at")
  /// 备注
  remark        String?
  recharges     MarketingRecharge[]
  consumptions  MarketingConsumption[]
  pointsRecords MarketingPointsRecord[]
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  @@unique([storeId, phone])
  @@index([storeId, updatedAt])
  @@index([storeId, tier, updatedAt])
  @@index([storeId, lastVisitAt])
  @@map("marketing_customers")
}

/// 营销顾客储值记录
model MarketingRecharge {
  id          Int                   @id @default(autoincrement())
  storeId     Int                   @map("store_id")
  store       Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId  Int                   @map("customer_id")
  customer    MarketingCustomer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// 充值金额（分）
  amount      Int
  /// 赠送金额（分）
  giftAmount  Int                   @default(0) @map("gift_amount")
  /// 类型：recharge=储值 gift=赠送 refund=退款
  type        MarketingRechargeType @default(recharge)
  /// 关联活动 ID（字符串，对应 MarketingPromotion.id）
  promotionId Int?                  @map("promotion_id")
  promotion   MarketingPromotion?   @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  /// 备注
  note        String?
  createdAt   DateTime              @default(now()) @map("created_at")

  @@index([storeId, createdAt])
  @@index([customerId, createdAt])
  @@index([storeId, type, createdAt])
  @@map("marketing_recharges")
}

/// 营销顾客消费记录
model MarketingConsumption {
  id             Int                 @id @default(autoincrement())
  storeId        Int                 @map("store_id")
  store          Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId     Int                 @map("customer_id")
  customer       MarketingCustomer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// 消费金额（分）
  amount         Int
  /// 余额支付金额（分）
  balancePaid    Int                 @default(0) @map("balance_paid")
  /// 积分抵扣金额（分）
  pointsDeducted Int                 @default(0) @map("points_deducted")
  /// 支付方式
  payType        MarketingPayType    @default(cash) @map("pay_type")
  /// 商品简述（如「拿铁 × 2」）
  itemsSummary   String?             @map("items_summary")
  /// 关联活动 ID
  promotionId    Int?                @map("promotion_id")
  promotion      MarketingPromotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now()) @map("created_at")

  @@index([storeId, createdAt])
  @@index([customerId, createdAt])
  @@map("marketing_consumptions")
}

/// 营销优惠活动
model MarketingPointsRecord {
  id          Int                       @id @default(autoincrement())
  storeId     Int                       @map("store_id")
  store       Store                     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId  Int                       @map("customer_id")
  customer    MarketingCustomer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// 积分变动值：正数=获得，负数=消耗
  amount      Int
  /// 积分变动类型
  type        MarketingPointsChangeType
  /// 前端直接展示的说明文案
  description String
  createdAt   DateTime                  @default(now()) @map("created_at")

  @@index([storeId, createdAt])
  @@index([customerId, createdAt])
  @@index([storeId, type, createdAt])
  @@map("marketing_points_records")
}

/// 营销优惠活动
model MarketingPromotion {
  id            Int                    @id @default(autoincrement())
  storeId       Int                    @map("store_id")
  store         Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// 活动名称
  name          String
  /// 活动类型
  type          MarketingPromotionType
  /// 活动描述
  description   String                 @default("")
  /// 优惠参数（JSON，按 type 存不同结构）
  params        Json                   @default("{}")
  /// 开始时间
  startAt       DateTime               @map("start_at")
  /// 结束时间
  endAt         DateTime               @map("end_at")
  /// 参与人次（实际使用次数）
  usageCount    Int                    @default(0) @map("usage_count")
  /// 核销总金额（分）
  totalDiscount Int                    @default(0) @map("total_discount")
  /// 是否上架
  enabled       Boolean                @default(true)
  recharges     MarketingRecharge[]
  consumptions  MarketingConsumption[]
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  @@index([storeId, enabled, startAt])
  @@index([storeId, createdAt])
  @@map("marketing_promotions")
}
