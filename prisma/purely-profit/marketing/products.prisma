model MarketingProductCategory {
  id        Int                @id @default(autoincrement())
  storeId   Int                @map("store_id")
  name      String
  icon      String?
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  store     Store              @relation(fields: [storeId], references: [id])
  products  MarketingProduct[]

  @@unique([storeId, name])
  @@index([storeId, updatedAt])
  @@map("marketing_product_categories")
}

model MarketingProduct {
  id               Int                      @id @default(autoincrement())
  storeId          Int                      @map("store_id")
  categoryId       Int                      @map("category_id")
  name             String
  price            Int
  originalPrice    Int?                     @map("original_price")
  image            String?
  descriptionTitle String?                  @map("description_title")
  description      String?
  stock            Int                      @default(0)
  durationMinutes  Int?                     @map("duration_minutes")
  personCount      Int?                     @map("person_count")
  unit             String?                  @map("unit")
  isActive         Boolean                  @default(true) @map("is_active")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  category         MarketingProductCategory @relation(fields: [categoryId], references: [id])
  store            Store                    @relation(fields: [storeId], references: [id])

  @@unique([storeId, name])
  @@index([storeId, createdAt])
  @@index([storeId, categoryId, createdAt])
  @@index([storeId, isActive, updatedAt])
  @@index([storeId, name])
  @@index([storeId, price])
  @@map("marketing_products")
}
