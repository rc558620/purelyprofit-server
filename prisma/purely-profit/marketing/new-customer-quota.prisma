// ═══════════════════════════════════════════════════════════════════
// 新用户额度：门店维度的「微信 getPhoneNumber 调用次数」余额
//
// 计量单位：位新客（1 位新客 = 1 次 getPhoneNumber 调用 = 0.03 元）
// 余额本体挂在 StoreMembershipProfile 上（见 member/platform-membership.prisma），
// 本文件只承载流水与「新客消耗幂等」两张表。
// ═══════════════════════════════════════════════════════════════════

/// 额度流水：充值 / 会员赠送 / 新客消耗 / 清零
model StoreNewCustomerQuotaLog {
  id           Int                          @id @default(autoincrement())
  storeId      Int                          @map("store_id")
  /// 变动类型：recharge=充值 grant=会员赠送 consume=新客消耗 clear=清零
  /// admin_adjust=平台运营调整（见 StoreNewCustomerQuotaLogType 注释）
  type         StoreNewCustomerQuotaLogType
  /// 变动数量：正数为增加，负数为消耗（单位：位新客）
  changeAmount Int                          @map("change_amount")
  /// 变动后的余额
  balanceAfter Int                          @map("balance_after")
  /// 充值金额（分），仅 recharge 有值
  amountFen    Int?                         @map("amount_fen")
  /// 关联订单号，仅 recharge 有值
  orderId      String?                      @map("order_id")
  /// 流水说明
  description  String
  createdAt    DateTime                     @default(now()) @map("created_at")

  @@index([storeId, createdAt])
  @@index([storeId, type, createdAt])
  @@map("store_new_customer_quota_logs")
}

/// 新客消耗记录：保证同一顾客只扣一次额度（**跨门店全局唯一**）
model StoreNewCustomerQuotaConsume {
  id         Int      @id @default(autoincrement())
  /// 实际为其支付额度的门店：第一家服务该顾客的门店
  storeId    Int      @map("store_id")
  /// 新客的 C 端账号 ID。
  ///
  /// 判定与幂等**必须以账号为准，不能用手机号**：扫码进桌即建档（占位手机号
  /// `club_wechat:{openid}`），随后绑定手机号会把该档案迁成真实号码，
  /// 手机号口径会把真正的首单新客误判成老客，导致额度永不消耗。
  ///
  /// 唯一约束**刻意不带 storeId**：手机号认证一位顾客只需一次，在任意一家门店
  /// 认证过之后换到别的门店都不再验证、不再扣额度。额度由第一家服务他的门店承担。
  clubUserId Int      @unique @map("club_user_id")
  /// 消耗时的手机号快照（未绑手机号即下单时为空），仅用于运营追溯
  phone      String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([storeId, phone])
  @@map("store_new_customer_quota_consumes")
}

/// 额度流水类型。
///
/// `admin_adjust` 必须与 `grant` 分开：平台运营在 purelyPulse 代商家发放 / 回收
/// 额度，它既不是商家自己充的钱、也不是会员赠送，混进 `grant` 会让商家端
/// 「累计会员赠送」把运营发放的量也算进去，与页面宣称的「月50 / 季100 / 年300」对不上。
enum StoreNewCustomerQuotaLogType {
  recharge
  grant
  consume
  clear
  admin_adjust
}
