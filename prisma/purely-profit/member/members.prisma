model Member {
  id                 Int                 @id @default(autoincrement())
  storeId            Int                 @map("store_id")
  /// 显式外键关联到 MarketingCustomer（可为 null，兼容历史数据）
  customerId         Int?                @unique @map("customer_id")
  /// 会员姓名
  name               String
  /// 手机号（可为 null）
  phone              String?
  /// 性别
  gender             MemberGender        @default(unknown)
  /// 标签数组
  tags               String[]            @default([])
  /// 备注
  note               String?
  /// 生日
  birthday           DateTime?
  /// 业务标识：是否合伙人
  isPartner          Boolean             @default(false) @map("is_partner")
  /// 业务标识：合伙人等级
  partnerLevel       String?             @map("partner_level")
  /// 业务标识：封禁原因
  bannedReason       String?             @map("banned_reason")
  /// 会员状态（ACTIVE=正常 INACTIVE=停用 BANNED=封禁）
  status             MemberStatus        @default(active)
  /// 纯利豆余额（独立于营销积分，有独立的 MemberBeanLog 流水，保留在 Member）
  beanBalance        Int                 @default(0) @map("bean_balance")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  /// 软删除标记：非 null 表示已删除，值是删除时间
  deletedAt          DateTime?           @map("deleted_at")
  memberBeanLogs     MemberBeanLog[]
  memberPointsLogs   MemberPointsLog[]
  memberRechargeLogs MemberRechargeLog[]
  customer           MarketingCustomer?  @relation("MemberCustomer", fields: [customerId], references: [id])
  store              Store               @relation(fields: [storeId], references: [id])

  @@index([storeId, phone])
  @@index([storeId, updatedAt])
  @@index([storeId, status, updatedAt])
  @@index([storeId, isPartner, updatedAt])
  @@index([phone])
  @@map("members")
}

model MemberPointsLog {
  id              Int                    @id @default(autoincrement())
  memberId        Int                    @map("member_id")
  storeId         Int                    @map("store_id")
  operatorStaffId Int?                   @map("operator_staff_id")
  changeType      MemberPointsChangeType @map("change_type")
  source          MemberPointsSource     @default(admin_adjust)
  changeAmount    Int                    @map("change_amount")
  beforePoints    Int                    @map("before_points")
  afterPoints     Int                    @map("after_points")
  reason          String
  remark          String?
  expiresAt       DateTime?              @map("expires_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  member          Member                 @relation(fields: [memberId], references: [id])
  operatorStaff   Staff?                 @relation("MemberPointsLogsOperator", fields: [operatorStaffId], references: [id])
  store           Store                  @relation(fields: [storeId], references: [id])

  @@index([memberId, createdAt])
  @@index([storeId, createdAt])
  @@index([operatorStaffId, createdAt])
  @@index([source, createdAt])
  @@map("member_points_logs")
}

model MemberBeanLog {
  id              Int              @id @default(autoincrement())
  memberId        Int              @map("member_id")
  storeId         Int              @map("store_id")
  operatorStaffId Int?             @map("operator_staff_id")
  source          MemberBeanSource
  changeAmount    Int              @map("change_amount")
  beforeBalance   Int              @map("before_balance")
  afterBalance    Int              @map("after_balance")
  reason          String
  relatedPromoId  String?          @map("related_promo_id")
  relatedUser     String?          @map("related_user")
  createdAt       DateTime         @default(now()) @map("created_at")
  member          Member           @relation(fields: [memberId], references: [id])
  operatorStaff   Staff?           @relation("MemberBeanLogsOperator", fields: [operatorStaffId], references: [id])
  store           Store            @relation(fields: [storeId], references: [id])

  @@index([memberId, createdAt])
  @@index([storeId, createdAt])
  @@index([operatorStaffId, createdAt])
  @@index([source, createdAt])
  @@map("member_bean_logs")
}

model MemberRechargeLog {
  id              Int                   @id @default(autoincrement())
  memberId        Int                   @map("member_id")
  storeId         Int                   @map("store_id")
  operatorStaffId Int?                  @map("operator_staff_id")
  planName        String                @map("plan_name")
  amount          Int
  pointsAwarded   Int                   @default(0) @map("points_awarded")
  channel         MemberRechargeChannel
  createdAt       DateTime              @default(now()) @map("created_at")
  member          Member                @relation(fields: [memberId], references: [id])
  operatorStaff   Staff?                @relation("MemberRechargeLogsOperator", fields: [operatorStaffId], references: [id])
  store           Store                 @relation(fields: [storeId], references: [id])

  @@index([memberId, createdAt])
  @@index([storeId, createdAt])
  @@index([operatorStaffId, createdAt])
  @@map("member_recharge_logs")
}

enum MemberGender {
  unknown
  male
  female
}

enum MemberStatus {
  active
  inactive
  banned
}

enum MemberPointsChangeType {
  increase
  decrease
}

enum MemberPointsSource {
  purchase_bonus
  deduct_payment
  admin_adjust
  expire
}

enum MemberBeanSource {
  promo_reward
  deduct_payment
  withdrawal
  admin_adjust
}

enum MemberRechargeChannel {
  wechat
  alipay
  card
}
