model EmployeeDepartment {
  id        Int        @id @default(autoincrement())
  storeId   Int        @map("store_id")
  name      String
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  store     Store      @relation(fields: [storeId], references: [id])
  employees Employee[]

  @@unique([storeId, name])
  @@index([storeId, updatedAt])
  @@map("employee_departments")
}

model EmployeePosition {
  id        Int        @id @default(autoincrement())
  storeId   Int        @map("store_id")
  name      String
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  store     Store      @relation(fields: [storeId], references: [id])
  employees Employee[]

  @@unique([storeId, name])
  @@index([storeId, updatedAt])
  @@map("employee_positions")
}

model Employee {
  id               Int                   @id @default(autoincrement())
  storeId          Int                   @map("store_id")
  linkedStaffId    Int?                  @unique @map("linked_staff_id")
  departmentId     Int?                  @map("department_id")
  positionId       Int?                  @map("position_id")
  empNo            String                @map("emp_no")
  name             String
  phone            String
  position         String
  department       String
  joinDate         DateTime              @map("join_date")
  baseSalary       Int                   @map("base_salary")
  avatar           String?
  idCard           String?               @map("id_card")
  gender           EmployeeGender        @default(unset)
  emergencyContact String?               @map("emergency_contact")
  emergencyPhone   String?               @map("emergency_phone")
  contractEndDate  DateTime?             @map("contract_end_date")
  note             String?
  status           EmployeeStatus        @default(active)
  resignDate       DateTime?             @map("resign_date")
  resignReason     String?               @map("resign_reason")
  /// 软删除标记：非 null 表示已删除，值是删除时间
  deletedAt        DateTime?             @map("deleted_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  leaveRecords     EmployeeLeave[]
  payrollRecords   EmployeePayroll[]
  shiftRecords     EmployeeShift[]
  departmentRecord EmployeeDepartment?   @relation(fields: [departmentId], references: [id])
  linkedStaff      Staff?                @relation("StaffEmployeeProfile", fields: [linkedStaffId], references: [id])
  positionRecord   EmployeePosition?     @relation(fields: [positionId], references: [id])
  store            Store                 @relation(fields: [storeId], references: [id])
  handoverFrom     StoreHandoverRecord[] @relation("HandoverFromEmployee")
  handoverTo       StoreHandoverRecord[] @relation("HandoverToEmployee")
  subAccounts      StoreSubAccount?      @relation("EmployeeSubAccounts")

  @@index([storeId, empNo])
  @@index([storeId, status, updatedAt])
  @@index([storeId, department, updatedAt])
  @@index([storeId, position, updatedAt])
  @@index([storeId, joinDate])
  @@index([departmentId])
  @@index([positionId])
  @@map("employees")
}

model EmployeeShiftDefinition {
  id               Int             @id @default(autoincrement())
  storeId          Int             @map("store_id")
  name             String
  defaultStartTime String          @map("default_start_time")
  defaultEndTime   String          @map("default_end_time")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  store            Store           @relation(fields: [storeId], references: [id])
  shiftRecords     EmployeeShift[]

  @@unique([storeId, name])
  @@index([storeId, updatedAt])
  @@map("employee_shift_definitions")
}

model EmployeeLeave {
  id           Int               @id @default(autoincrement())
  storeId      Int               @map("store_id")
  employeeId   Int               @map("employee_id")
  employeeName String            @map("employee_name")
  type         EmployeeLeaveType
  startDate    DateTime          @map("start_date")
  endDate      DateTime          @map("end_date")
  days         Decimal           @db.Decimal(6, 2)
  deductSalary Boolean           @map("deduct_salary")
  deductAmount Int               @map("deduct_amount")
  note         String?
  createdAt    DateTime          @default(now()) @map("created_at")
  employee     Employee          @relation(fields: [employeeId], references: [id])
  store        Store             @relation(fields: [storeId], references: [id])

  @@index([employeeId, startDate])
  @@index([storeId, startDate])
  @@map("employee_leaves")
}

model EmployeeShift {
  id                Int                      @id @default(autoincrement())
  storeId           Int                      @map("store_id")
  employeeId        Int                      @map("employee_id")
  employeeName      String                   @map("employee_name")
  shiftType         EmployeeShiftType?       @map("shift_type")
  shiftDefinitionId Int?                     @map("shift_definition_id")
  shiftName         String                   @map("shift_name")
  date              DateTime
  startTime         String                   @map("start_time")
  endTime           String                   @map("end_time")
  note              String?
  createdAt         DateTime                 @default(now()) @map("created_at")
  employee          Employee                 @relation(fields: [employeeId], references: [id])
  shiftDefinition   EmployeeShiftDefinition? @relation(fields: [shiftDefinitionId], references: [id])
  store             Store                    @relation(fields: [storeId], references: [id])

  @@unique([employeeId, date])
  @@index([storeId, date])
  @@index([shiftDefinitionId, date])
  @@map("employee_shifts")
}

model EmployeePayroll {
  id                 Int                   @id @default(autoincrement())
  storeId            Int                   @map("store_id")
  employeeId         Int                   @map("employee_id")
  employeeName       String                @map("employee_name")
  month              DateTime
  baseSalary         Int                   @map("base_salary")
  leaveDeduction     Int                   @map("leave_deduction")
  otherDeduction     Int                   @map("other_deduction")
  otherDeductionNote String?               @map("other_deduction_note")
  bonus              Int
  actualSalary       Int                   @map("actual_salary")
  socialInsurance    Int                   @default(0) @map("social_insurance")
  housingFund        Int                   @default(0) @map("housing_fund")
  totalLaborCost     Int                   @map("total_labor_cost")
  status             EmployeePayrollStatus @default(draft)
  confirmedAt        DateTime?             @map("confirmed_at")
  note               String?
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  costRecords        CostRecord[]
  employee           Employee              @relation(fields: [employeeId], references: [id])
  store              Store                 @relation(fields: [storeId], references: [id])

  @@unique([employeeId, month])
  @@index([storeId, month])
  @@index([storeId, status, month])
  @@map("employee_payrolls")
}

enum EmployeeStatus {
  active
  resigned
}

enum EmployeeGender {
  male
  female
  unset
}

enum EmployeeLeaveType {
  personal
  sick
  annual
  marriage
  other
}

enum EmployeeShiftType {
  morning
  nine_to_six
  middle
  late
  full
  custom
}

enum EmployeePayrollStatus {
  draft
  confirmed
}
