model FinanceReconciliationRecord {
  id                     Int                         @id @default(autoincrement())
  storeId                Int                         @map("store_id")
  operatorStaffId        Int?                        @map("operator_staff_id")
  title                  String
  type                   FinanceReconciliationType
  status                 FinanceReconciliationStatus @default(draft)
  channel                FinancePaymentChannel?
  counterpart            String?
  periodStart            DateTime                    @map("period_start")
  periodEnd              DateTime                    @map("period_end")
  bookIncome             Int                         @map("book_income")
  bookExpense            Int                         @map("book_expense")
  bookNet                Int                         @map("book_net")
  actualIncome           Int?                        @map("actual_income")
  actualExpense          Int?                        @map("actual_expense")
  actualNet              Int                         @map("actual_net")
  diffAmount             Int                         @map("diff_amount")
  adjustNote             String?                     @map("adjust_note")
  settlementBatchNo      String?                     @map("settlement_batch_no")
  linkedOrderNos         String?                     @map("linked_order_nos")
  linkedOrderCount       Int?                        @map("linked_order_count")
  linkedReceivableAmount Int?                        @map("linked_receivable_amount")
  linkedSettledAmount    Int?                        @map("linked_settled_amount")
  linkedFeeAmount        Int?                        @map("linked_fee_amount")
  operator               String?
  note                   String?
  date                   DateTime
  createdAt              DateTime                    @default(now()) @map("created_at")
  updatedAt              DateTime                    @updatedAt @map("updated_at")
  items                  FinanceReconciliationItem[]
  operatorStaff          Staff?                      @relation("FinanceReconciliationOperator", fields: [operatorStaffId], references: [id])
  store                  Store                       @relation(fields: [storeId], references: [id])

  @@index([storeId, status, date])
  @@index([storeId, type, date])
  @@index([operatorStaffId, createdAt])
  @@map("finance_reconciliation_records")
}

model FinanceReconciliationItem {
  id               Int                         @id @default(autoincrement())
  reconciliationId Int                         @map("reconciliation_id")
  description      String
  bookAmount       Int                         @map("book_amount")
  actualAmount     Int                         @map("actual_amount")
  difference       Int
  note             String?
  createdAt        DateTime                    @default(now()) @map("created_at")
  reconciliation   FinanceReconciliationRecord @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  @@index([reconciliationId, createdAt])
  @@map("finance_reconciliation_items")
}

enum FinanceReconciliationStatus {
  draft
  confirmed
  discrepancy
  adjusted
}

enum FinanceReconciliationType {
  daily
  weekly
  monthly
  payment
  supplier
  custom
}

enum FinancePaymentChannel {
  cash
  wechat
  alipay
  card
  bank
  all
}
