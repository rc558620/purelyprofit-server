// purely-profit/finance: 往来账模型

enum FinanceAccountType {
  receivable
  payable
}

enum FinanceAccountStatus {
  pending
  partial
  settled
  overdue
}

enum FinanceAccountCategory {
  sales_credit
  advance_paid
  supplier_debt
  loan
  deposit
  other
}

model FinanceAccountRecord {
  id              Int                    @id @default(autoincrement())
  storeId         Int                    @map("store_id")
  store           Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  operatorStaffId Int?                   @map("operator_staff_id")
  operatorStaff   Staff?                 @relation("FinanceAccountOperator", fields: [operatorStaffId], references: [id], onDelete: SetNull)
  type            FinanceAccountType
  category        FinanceAccountCategory
  counterpart     String
  amount          Decimal                @db.Decimal(12, 2)
  paidAmount      Decimal                @default(0) @map("paid_amount") @db.Decimal(12, 2)
  remaining       Decimal                @default(0) @db.Decimal(12, 2)
  status          FinanceAccountStatus   @default(pending)
  dueDate         DateTime?              @map("due_date")
  date            DateTime
  note            String?
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  @@index([storeId, status, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([storeId, type, updatedAt])
  @@index([storeId, dueDate])
  @@index([operatorStaffId, createdAt])
  @@map("finance_account_records")
}
