model FinanceAccountRecord {
  id              Int                    @id @default(autoincrement())
  storeId         Int                    @map("store_id")
  operatorStaffId Int?                   @map("operator_staff_id")
  type            FinanceAccountType
  category        FinanceAccountCategory
  counterpart     String
  amount          Int
  paidAmount      Int                    @default(0) @map("paid_amount")
  remaining       Int                    @default(0)
  status          FinanceAccountStatus   @default(pending)
  dueDate         DateTime?              @map("due_date")
  date            DateTime
  note            String?
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  operatorStaff   Staff?                 @relation("FinanceAccountOperator", fields: [operatorStaffId], references: [id])
  store           Store                  @relation(fields: [storeId], references: [id])

  @@index([storeId, status, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([storeId, type, updatedAt])
  @@index([storeId, dueDate])
  @@index([operatorStaffId, createdAt])
  @@map("finance_account_records")
}

enum FinanceAccountType {
  receivable
  payable
}

enum FinanceAccountStatus {
  pending
  partial
  settled
  overdue
}

enum FinanceAccountCategory {
  sales_credit
  advance_paid
  supplier_debt
  loan
  deposit
  other
}
