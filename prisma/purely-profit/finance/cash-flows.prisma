model FinanceCashFlowRecord {
  id              Int                      @id @default(autoincrement())
  storeId         Int                      @map("store_id")
  saleOrderId     Int?                     @unique @map("sale_order_id")
  saleOrderRefundId Int?                   @unique @map("sale_order_refund_id")
  operatorStaffId Int?                     @map("operator_staff_id")
  direction       FinanceCashFlowDirection
  category        FinanceCashFlowCategory
  title           String
  amount          Int
  payment         FinanceCashFlowPayment
  note            String?
  date            DateTime
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  operatorStaff   Staff?                   @relation("FinanceCashFlowOperator", fields: [operatorStaffId], references: [id])
  saleOrder       SaleOrder?               @relation(fields: [saleOrderId], references: [id])
  saleOrderRefund SaleOrderRefund?         @relation(fields: [saleOrderRefundId], references: [id])
  store           Store                    @relation(fields: [storeId], references: [id])

  @@index([storeId, date(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
  @@index([storeId, direction, date])
  @@index([storeId, category, date])
  @@index([operatorStaffId, createdAt])
  @@map("finance_cash_flow_records")
}

enum FinanceCashFlowDirection {
  income
  expense
}

enum FinanceCashFlowCategory {
  sales
  platform_settlement
  refund
  transfer_in
  other_income
  purchase
  rent
  utilities
  salary
  marketing
  tax
  platform_fee
  transfer_out
  other_expense
}

enum FinanceCashFlowPayment {
  cash
  wechat
  alipay
  card
  bank
  meituan
  douyin
  platform
  other
}
