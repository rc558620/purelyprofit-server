model InventoryAdjustmentLog {
  id              Int                 @id @default(autoincrement())
  storeId         Int                 @map("store_id")
  productId       Int                 @map("product_id")
  purchaseOrderId Int?                @map("purchase_order_id")
  saleOrderId     Int?                @map("sale_order_id")
  operatorStaffId Int?                @map("operator_staff_id")
  productName     String              @map("product_name")
  beforeStock     Int                 @map("before_stock")
  afterStock      Int                 @map("after_stock")
  delta           Int
  adjustType      InventoryAdjustType @map("adjust_type")
  note            String?
  createdAt       DateTime            @default(now()) @map("created_at")
  operatorStaff   Staff?              @relation("InventoryAdjustmentOperator", fields: [operatorStaffId], references: [id])
  product         Product             @relation(fields: [productId], references: [id])
  purchaseOrder   PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id])
  saleOrder       SaleOrder?          @relation(fields: [saleOrderId], references: [id])
  store           Store               @relation(fields: [storeId], references: [id])

  // 库存流水列表恒按 createdAt DESC + id DESC 分页：把 id 纳入索引并显式声明
  // 排序方向，PG 可直接按索引有序输出、取满 LIMIT 即终止，省掉 top-N sort。
  // 该索引是旧 (storeId, createdAt) 的超集，旧索引已在
  // 20261110120000_add_inventory_adjustment_log_indexes 中 DROP。
  @@index([storeId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_inventory_adjustment_logs_store_created_id_desc")
  @@index([productId, createdAt])
  @@index([purchaseOrderId, createdAt])
  @@index([saleOrderId, createdAt])
  @@index([operatorStaffId, createdAt])
  @@map("inventory_adjustment_logs")
}

enum InventoryAdjustType {
  restock
  damage
  manual
  sale
  /// 客存取出解冻：物理库存不变，记录可用库存（stock − 在存量）回升
  custody_pickup
  /// 客存存入占用：物理库存不变，记录可用库存被寄存量占用
  custody_freeze
  /// 客存作废解冻：作废冻结口径存单时释放占用
  custody_release
}
