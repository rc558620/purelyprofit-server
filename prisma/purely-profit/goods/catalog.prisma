model ProductCategory {
  id        Int       @id @default(autoincrement())
  storeId   Int       @map("store_id")
  name      String
  icon      String?
  /// 软删除标记：非 null 表示已删除，值是删除时间
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  store     Store     @relation(fields: [storeId], references: [id])
  products  Product[]

  @@index([storeId, name])
  @@index([storeId, updatedAt])
  @@map("product_categories")
}

model Product {
  id                       Int                       @id @default(autoincrement())
  storeId                  Int                       @map("store_id")
  categoryId               Int?                      @map("category_id")
  category                 String
  code                     String
  name                     String
  price                    Int
  profit                   Int
  costPrice                Int?                      @map("cost_price")
  unit                     String
  stock                    Int                       @default(0)
  alertThreshold           Int                       @default(10) @map("alert_threshold")
  image                    String?
  description              String?
  isActive                 Boolean                   @default(true) @map("is_active")
  /// 软删除标记：非 null 表示已删除，值是删除时间
  deletedAt                DateTime?                 @map("deleted_at")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  inventoryLogs            InventoryAdjustmentLog[]
  categoryRecord           ProductCategory?          @relation(fields: [categoryId], references: [id])
  store                    Store                     @relation(fields: [storeId], references: [id])
  purchaseItems            PurchaseOrderItem[]
  salesItems               SaleOrderItem[]
  scanOrderingMenuProducts ScanOrderingMenuProduct[]

  @@index([storeId, code])
  @@index([storeId, category, updatedAt])
  @@index([storeId, isActive, updatedAt])
  @@index([categoryId, updatedAt])
  @@map("products")
}
