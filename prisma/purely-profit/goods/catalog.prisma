// purely-profit/goods: 商品目录模型

model ProductCategory {
  id        Int       @id @default(autoincrement())
  storeId   Int       @map("store_id")
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  name      String
  icon      String?
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([storeId, name])
  @@index([storeId, updatedAt])
  @@map("product_categories")
}

model Product {
  id             Int                      @id @default(autoincrement())
  storeId        Int                      @map("store_id")
  store          Store                    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  categoryId     Int?                     @map("category_id")
  categoryRecord ProductCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  category       String
  code           String
  name           String
  price          Decimal                  @db.Decimal(12, 2)
  profit         Decimal                  @db.Decimal(12, 2)
  costPrice      Decimal?                 @map("cost_price") @db.Decimal(12, 2)
  unit           String
  stock          Int                      @default(0)
  alertThreshold Int                      @default(10) @map("alert_threshold")
  image          String?
  description    String?
  isActive       Boolean                  @default(true) @map("is_active")
  purchaseItems  PurchaseOrderItem[]
  inventoryLogs  InventoryAdjustmentLog[]
  salesItems     SaleOrderItem[]
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  @@unique([storeId, code])
  @@index([storeId, category, updatedAt])
  @@index([storeId, isActive, updatedAt])
  @@index([categoryId, updatedAt])
  @@map("products")
}
