model ProductCategory {
  id        Int       @id @default(autoincrement())
  storeId   Int       @map("store_id")
  name      String
  icon      String?
  /// 软删除标记：非 null 表示已删除，值是删除时间
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  store     Store     @relation(fields: [storeId], references: [id])
  products  Product[]

  @@index([storeId, name], where: raw("(deleted_at IS NULL)"))
  @@index([storeId, updatedAt], where: raw("(deleted_at IS NULL)"))
  @@map("product_categories")
}

model Product {
  id                       Int                       @id @default(autoincrement())
  storeId                  Int                       @map("store_id")
  categoryId               Int?                      @map("category_id")
  category                 String
  code                     String
  name                     String
  price                    Int
  profit                   Int
  costPrice                Int?                      @map("cost_price")
  unit                     String
  stock                    Int                       @default(0)
  alertThreshold           Int                       @default(10) @map("alert_threshold")
  image                    String?
  description              String?
  isActive                 Boolean                   @default(true) @map("is_active")
  /// 软删除标记：非 null 表示已删除，值是删除时间
  deletedAt                DateTime?                 @map("deleted_at")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  inventoryLogs            InventoryAdjustmentLog[]
  categoryRecord           ProductCategory?          @relation(fields: [categoryId], references: [id])
  store                    Store                     @relation(fields: [storeId], references: [id])
  purchaseItems            PurchaseOrderItem[]
  salesItems               SaleOrderItem[]
  scanOrderingMenuProducts ScanOrderingMenuProduct[]

  // 编号唯一性由库内部分唯一索引兜底：只约束未软删除行，软删后编号可复用，
  // 与 findProductCodeConflict 的 deletedAt: null 口径一致。
  // 直接把原普通索引升级为唯一索引（索引总数不变），避免给高频库存扣减
  // 额外增加一棵需要维护的 btree。
  @@unique([storeId, code], map: "uq_products_store_code_active", where: raw("(deleted_at IS NULL)"))
  // 库存扣减是 products 上最高频的写（stock + @updatedAt）。updatedAt 从未作为
  // products 查询的筛选 / 排序前导列（仅两处预警列表以 stock 为首列排序），放进
  // 索引只会让每次扣减维护 3 条 btree 并使 HOT 更新失效。这里只保留真正参与
  // 过滤的前两列，让 updated_at 脱离索引：库存扣减可走 HOT，索引也更短。
  @@index([storeId, category], where: raw("(deleted_at IS NULL)"))
  @@index([storeId, isActive], where: raw("(deleted_at IS NULL)"))
  @@index([categoryId])
  @@map("products")
}
