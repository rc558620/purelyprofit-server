model SaleOrder {
  id                           Int                      @id @default(autoincrement())
  storeId                      Int                      @map("store_id")
  operatorStaffId              Int?                     @map("operator_staff_id")
  operatorNameSnapshot         String?                  @map("operator_name_snapshot") @db.VarChar(100)
  orderNo                      String                   @map("order_no")
  totalRevenue                 Int                      @map("total_revenue")
  totalProfit                  Int                      @map("total_profit")
  totalQuantity                Int                      @map("total_quantity")
  paymentMethod                SalesPaymentMethod       @map("payment_method")
  calcMode                     SalesCalcMode            @default(business) @map("calc_mode")
  note                         String?
  date                         DateTime
  customerPaymentMethod        String?                  @map("customer_payment_method")
  grouponCode                  String?                  @map("groupon_code")
  grouponPlatform              String?                  @map("groupon_platform")
  settlementChannel            String?                  @map("settlement_channel")
  voucherCode                  String?                  @map("voucher_code")
  voucherPlatform              String?                  @map("voucher_platform")
  voucherFaceAmount            Int?                     @map("voucher_face_amount")
  grouponSettlementStatus      String?                  @map("settlement_status")
  grouponPlatformReceivable    Int?                     @map("platform_receivable")
  grouponPlatformSettledAmount Int?                     @map("platform_settled_amount")
  grouponPlatformFee           Int?                     @map("platform_fee")
  scanOrderId                  Int?                     @unique @map("scan_order_id")
  /// 手工补录订单标记（true 表示由商家端「录入订单」功能补录的线下交易）
  manualEntry                  Boolean                  @default(false) @map("manual_entry")
  /// 手工补录：就餐方式（堂食/自取/第三方外卖）
  diningMode                   ManualEntryDiningMode?   @map("dining_mode")
  /// 手工补录：来源渠道（美团外卖/饿了么/美团团购/抖音团购/大众点评/其他）
  sourceChannel                ManualEntrySourceChannel? @map("source_channel")
  /// 手工补录：第三方平台结算单号（用于对账）
  externalOrderNo              String?                  @map("external_order_no") @db.VarChar(128)
  /// 手工补录：就餐人数
  guestCount                   Int?                     @map("guest_count")
  /// 手工补录：顾客手机号（用于订单归属）
  customerPhone                String?                  @map("customer_phone") @db.VarChar(20)
  /// 手工补录：堂食/团购到店关联的桌台
  diningTableId                Int?                     @map("dining_table_id")
  createdAt                    DateTime                 @default(now()) @map("created_at")
  updatedAt                    DateTime                 @updatedAt @map("updated_at")
  cashFlowRecord               FinanceCashFlowRecord?
  inventoryLogs                InventoryAdjustmentLog[]
  items                        SaleOrderItem[]
  operatorStaff                Staff?                   @relation("SaleOrderOperator", fields: [operatorStaffId], references: [id])
  store                        Store                    @relation(fields: [storeId], references: [id])
  spaceSession                 SpaceSession?
  scanOrder                    ScanOrders?              @relation("ScanOrderSaleOrder", fields: [scanOrderId], references: [id])
  refund                       SaleOrderRefund?
  diningTable                  ScanOrderingTable?       @relation("SaleOrderDiningTable", fields: [diningTableId], references: [id])

  @@unique([storeId, orderNo])
  @@index([storeId, date(sort: Desc), id(sort: Desc)])
  @@index([storeId, createdAt])
  @@index([operatorStaffId, createdAt])
  @@index([storeId, manualEntry, createdAt])
  @@map("sale_orders")
}

model SaleOrderItem {
  id           Int       @id @default(autoincrement())
  orderId      Int       @map("order_id")
  storeId      Int       @map("store_id")
  productId    Int?      @map("product_id")
  productName  String    @map("product_name")
  categoryName String    @map("category_name")
  salePrice    Int       @map("sale_price")
  profit       Int
  quantity     Int
  image        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  order        SaleOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product?  @relation(fields: [productId], references: [id])
  store        Store     @relation(fields: [storeId], references: [id])

  @@index([orderId, createdAt])
  @@index([storeId, createdAt])
  @@index([productId, createdAt])
  @@index([categoryName, createdAt])
  @@map("sale_order_items")
}

model SaleOrderRefund {
  id             Int                    @id @default(autoincrement())
  saleOrderId    Int                    @unique @map("sale_order_id")
  storeId        Int                    @map("store_id")
  amount         Int
  profit         Int
  paymentMethod  SalesPaymentMethod     @map("payment_method")
  refundedAt     DateTime               @map("refunded_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  saleOrder      SaleOrder              @relation(fields: [saleOrderId], references: [id], onDelete: Restrict)
  store          Store                  @relation(fields: [storeId], references: [id])
  cashFlowRecord FinanceCashFlowRecord?

  @@index([storeId, refundedAt(sort: Desc)])
  @@map("sale_order_refunds")
}

enum SalesPaymentMethod {
  cash
  wechat
  alipay
  card
  other
  groupon_voucher
  platform
}

enum SalesCalcMode {
  profit
  business
}

/// 手工补录订单就餐方式：dineIn 堂食/团购到店 / takeaway 自取 / platform 第三方外卖
enum ManualEntryDiningMode {
  dineIn
  takeaway
  platform
}

/// 手工补录订单来源渠道：美团外卖/饿了么/美团团购/抖音团购/大众点评/其他平台
enum ManualEntrySourceChannel {
  meituan
  eleme
  meituanVoucher
  douyin
  dianping
  other
}
