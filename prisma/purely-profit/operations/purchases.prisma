// purely-profit/operations/purchases: 采购模型

model Supplier {
  id        Int             @id @default(autoincrement())
  storeId   Int             @map("store_id")
  store     Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  name      String
  contact   String?
  phone     String?
  category  String?
  note      String?
  orders    PurchaseOrder[]
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@unique([storeId, name])
  @@index([storeId, updatedAt])
  @@map("suppliers")
}

model PurchaseOrder {
  id              Int                      @id @default(autoincrement())
  storeId         Int                      @map("store_id")
  store           Store                    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  supplierId      Int?                     @map("supplier_id")
  supplier        Supplier?                @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  operatorStaffId Int?                     @map("operator_staff_id")
  operatorStaff   Staff?                   @relation("PurchaseOrderOperator", fields: [operatorStaffId], references: [id], onDelete: SetNull)
  supplierName    String?                  @map("supplier_name")
  totalAmount     Int                      @map("total_amount") // 总金额（分）
  date            DateTime
  note            String?
  items           PurchaseOrderItem[]
  inventoryLogs   InventoryAdjustmentLog[]
  costRecords     CostRecord[]
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  @@index([storeId, date])
  @@index([supplierId, date])
  @@index([operatorStaffId, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          Int           @id @default(autoincrement())
  orderId     Int           @map("order_id")
  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeId     Int           @map("store_id")
  store       Store         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  productId   Int?          @map("product_id")
  product     Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String        @map("product_name")
  unit        String?
  quantity    Int
  unitPrice   Int           @map("unit_price")                 // 单价（分）
  amount      Int                                              // 小计（分）
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@index([storeId, createdAt])
  @@index([productId, createdAt])
  @@map("purchase_order_items")
}
