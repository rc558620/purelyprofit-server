model CostRecord {
  id              Int              @id @default(autoincrement())
  storeId         Int              @map("store_id")
  operatorStaffId Int?             @map("operator_staff_id")
  purchaseOrderId Int?             @map("purchase_order_id")
  payrollId       Int?             @map("payroll_id")
  sourceType      CostSourceType   @map("source_type")
  title           String
  type            CostType
  category        CostCategory
  amount          Int
  note            String?
  date            DateTime
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  operatorStaff   Staff?           @relation("CostRecordOperator", fields: [operatorStaffId], references: [id])
  payroll         EmployeePayroll? @relation(fields: [payrollId], references: [id])
  purchaseOrder   PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])
  store           Store            @relation(fields: [storeId], references: [id])

  @@index([storeId, date(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
  @@index([storeId, type, date(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
  @@index([storeId, category, date])
  @@index([operatorStaffId, createdAt])
  @@map("cost_records")
}

enum CostType {
  fixed
  variable
}

enum CostCategory {
  rent
  salary
  insurance
  provident_fund
  utilities
  purchase
  equipment
  marketing
  packaging
  other
}

enum CostSourceType {
  manual
  purchase
  payroll_salary
  payroll_insurance
  payroll_provident_fund
}
