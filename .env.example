# App
PORT=3000
NODE_ENV=development
APP_CORS_ORIGIN=*
APP_SWAGGER_ENABLED=true
# 关掉全量 HTTP 访问日志（incoming request / request completed），默认仅在本地开发保持关闭
# 若要排查 HTTP 请求细节，临时改为 true 或启动时指定 APP_LOG_ENABLED=true
APP_LOG_ENABLED=false
APP_HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
APP_HTTP_REQUEST_TIMEOUT_MS=15000
APP_HTTP_BODY_LIMIT_BYTES=5242880
# 开发环境下若默认端口被占用，先尝试结束占用该端口的旧进程
APP_PORT_AUTO_TERMINATE_ENABLED=true
# 若旧进程无法结束，再自动顺延到后续可用端口
APP_PORT_AUTO_SHIFT_ENABLED=true
APP_PORT_AUTO_SHIFT_MAX_OFFSET=20
# 保留慢日志警告：接口耗时 >= 800ms 时告警
APP_SLOW_REQUEST_LOG_ENABLED=true
APP_SLOW_REQUEST_THRESHOLD_MS=800
# 保留慢 SQL 警告：查询耗时 >= 80ms 时告警
# 若要全量 SQL 排查，临时改为 true 或启动时指定 DEBUG=prisma:*
APP_SLOW_QUERY_LOG_ENABLED=true
APP_SLOW_QUERY_THRESHOLD_MS=80
# 保留慢 Redis 操作警告：操作耗时 >= 20ms 时告警
APP_SLOW_REDIS_LOG_ENABLED=true
APP_SLOW_REDIS_THRESHOLD_MS=20
APP_SQL_METRICS_ENABLED=true
APP_DEFAULT_PAGE_SIZE=20
APP_MAX_PAGE_SIZE=100
APP_CACHE_PREWARM_ENABLED=true
APP_CACHE_PREWARM_INTERVAL_MS=15000
APP_CACHE_PREWARM_INITIAL_DELAY_MS=5000
APP_CACHE_PREWARM_BATCH_SIZE=30
APP_CACHE_PREWARM_CONCURRENCY=4
APP_CACHE_PREWARM_LOG_ENABLED=true
APP_CACHE_PREWARM_LOG_SAMPLE_EVERY=20
APP_CACHE_PREWARM_SLOW_CYCLE_THRESHOLD_MS=1500
APP_CACHE_REFRESH_CONCURRENCY=8
# 空间自动结账后台调度（无需进入空间页面即可触发倒计时到期自动结账）
APP_SPACE_AUTO_CHECKOUT_ENABLED=true
APP_SPACE_AUTO_CHECKOUT_INTERVAL_MS=60000
APP_SPACE_AUTO_CHECKOUT_INITIAL_DELAY_MS=10000
# 前端 client-errors 错误上报日志
APP_CLIENT_ERROR_LOG_ENABLED=true
APP_CLIENT_ERROR_STACK_MAX_LENGTH=2000
APP_CLIENT_ERROR_DETAILS_MAX_LENGTH=2000
# 全局限流：同一 IP 在 ttl 秒内最多 limit 次请求（auth 接口有更严格的独立配置）
APP_THROTTLE_TTL_SECONDS=60
APP_THROTTLE_LIMIT=100

# 生产环境推荐覆盖以下开关
# NODE_ENV=production
# APP_CORS_ORIGIN=https://profit.example.com,https://club.example.com
# APP_SWAGGER_ENABLED=false
# APP_PORT_AUTO_TERMINATE_ENABLED=false
# APP_PORT_AUTO_SHIFT_ENABLED=false
# CLUB_MANUAL_CONFIRM_PAID_ENABLED=false

# ──────────────────────────────────────────────────────────────
# 集群模式（Cluster）
# ──────────────────────────────────────────────────────────────
# 生产环境建议使用 start:cluster 启动（多 worker 充分利用多核 CPU）
# CLUSTER_WORKERS 未配置时默认跟随 CPU 核数，建议显式配置以精确控制连接池预算
# 示例：4 核机器配 CLUSTER_WORKERS=4，PG max_connections=120，则每 worker poolMax 自动调整为 28
# CLUSTER_WORKERS=4

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/purelyprofit?schema=public"
# Prisma migrate diff / drift 检查使用的影子库，建议指向独立空库
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/purelyprofit_shadow?schema=public"
DATABASE_POOL_MAX=20
DATABASE_POOL_MIN=5
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
# 单条 SQL 语句超时（毫秒），防止单条慢查询无限占用连接池连接
DATABASE_STATEMENT_TIMEOUT_MS=10000
# PostgreSQL 侧 max_connections 值，集群模式下 PrismaService 会据此自动调整每 worker 的 poolMax
# 确保 workers × poolMax 不超过此值。未配置时默认 100。
DATABASE_PG_MAX_CONNECTIONS=100

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=3000
# BullMQ 会自动覆盖此值为 null（任务队列需要无限重试连接）
REDIS_MAX_RETRIES_PER_REQUEST=3

# ──────────────────────────────────────────────────────────────
# 分布式锁（Redis Distributed Lock）
# ──────────────────────────────────────────────────────────────
# 使用 Redis `SET NX EX` + Lua 脚本实现原子锁，防止多 worker 环境下的并发竞争
# 适用场景：
#   - 空间开台（防止重复开台）
#   - 交班确认（防止同一班次重复交班）
#   - 缓存预热（防止多 worker 同时预热同一缓存）
# 注意：
#   - 锁 TTL 应根据业务操作耗时合理设置（一般 10~20 秒）
#   - 锁获取失败时支持重试（retryTimes + retryDelayMs）
#   - 生产环境建议配置 Redis Sentinel 或 Cluster 保证高可用

# ──────────────────────────────────────────────────────────────
# 消息队列（BullMQ）
# ──────────────────────────────────────────────────────────────
# 基于 Redis + BullMQ 实现异步任务调度，替代 setInterval 轮询模式
# 当前队列：
#   - `cache-prewarm`：定时预热首页、经营分析等热点缓存
#   - `space-auto-checkout`：定时扫描并自动结账超时空间会话
# 优势：
#   - 多 worker 自动负载均衡（基于 Redis BLPOP）
#   - 任务失败自动重试（可配置 attempts）
#   - 任务元数据持久化（完成/失败记录可追溯）
#   - 支持定时任务、延时任务、优先级队列
# 注意：
#   - BullMQ 会自动将 Redis maxRetriesPerRequest 设为 null
#   - 任务默认超时 60s（可在 QueueModule 调整）
#   - 完成任务保留 1 天，失败任务保留 7 天

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Auth
AUTH_PASSWORD_RESET_CODE_TTL_SECONDS=600
AUTH_REGISTER_CODE_TTL_SECONDS=600
AUTH_SMS_SEND_COOLDOWN_SECONDS=60
# Admin 登录账号别名和手机号（生产环境务必覆盖，避免使用默认值）
# AUTH_ADMIN_LOGIN_ALIAS=admin
# AUTH_ADMIN_LOGIN_PHONE=13619654020

# Pulse
PULSE_DEV_ACCOUNT_EMAILS=

# Club payment callback
# CLUB_WECHAT_CALLBACK_SECRET 已废弃，保留仅供旧版兼容
CLUB_WECHAT_CALLBACK_MAX_AGE_SECONDS=300
# 开发环境可将此项设为 true，跳过微信支付直接手动确认订单为已付款（生产必须为 false）
CLUB_MANUAL_CONFIRM_PAID_ENABLED=true

# WeChat Pay（微信支付 JSAPI 直收模式）
# ─── 小程序 ──────────────────────────────────────────────────────────────────
# 微信小程序 AppID（purely-club 小程序，登录微信公众平台 → 开发 → AppID）
WECHAT_APP_ID=wx_your_miniprogram_appid
# 微信小程序 AppSecret（code2session 换取 openid，严禁泄露/落入版本控制）
# 微信公众平台 → 开发 → 开发管理 → 开发设置 → AppSecret
WECHAT_APP_SECRET=your_miniprogram_appsecret

# ─── 商户 API 证书（微信商户平台「账户中心 → API 安全」申请/下载）──────────────
# 商户 API 证书序列号（40 位十六进制，在商户平台查看）
WECHAT_MCH_SERIAL_NO=your_mch_api_certificate_serial_no

# 商户 API RSA 私钥：选以下两种方式之一填写，优先使用文件路径
# 方式 1：PEM 文件路径（生产推荐，文件权限设为 600）
WECHAT_PRIVATE_KEY_PATH=/etc/secrets/apiclient_key.pem
# 方式 2：PEM 内容内联（Docker secret / CI 注入，换行符用字面 \n 代替）
# WECHAT_PRIVATE_KEY_CONTENT=-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----

# ─── 支付回调 ─────────────────────────────────────────────────────────────────
# 微信支付回调通知地址（必须是公网可达的 HTTPS 地址，不能用 localhost）
# 格式：https://api.yourdomain.com/api/club/payments/wechat/callback
WECHAT_PAY_NOTIFY_URL=https://api.yourdomain.com/api/club/payments/wechat/callback

# ─── 可选：回调验签平台公钥 ───────────────────────────────────────────────────
# 微信支付平台公钥（PEM 格式内联），用于校验回调报文签名（Wechatpay-Signature）。
# 平台证书通过 GET /v3/certificates 接口下载，建议定期轮换（有效期约 1 年）。
# 未配置时跳过 RSA 验签，仅靠时间戳 ±300 秒防重放（首次上线可接受，生产建议配置）。
# WECHAT_PLATFORM_PUBLIC_KEY_CONTENT=-----BEGIN PUBLIC KEY-----\nMIIBIj...\n-----END PUBLIC KEY-----

# Release helpers（可直接被 scripts/release-execute.sh 读取）
# GitHub Actions production 环境建议同步配置以下变量 / secrets 中的同名项
SMOKE_BASE_URL=http://localhost:3000/api
SMOKE_TIMEOUT_SECONDS=10
RELEASE_REQUIRE_BACKUP=true
RELEASE_REQUIRE_RESTART=true
RELEASE_USE_DEFAULT_BACKUP=true
RELEASE_BACKUP_DIR=./backups
RELEASE_BACKUP_FILE_PREFIX=purelyprofit-server
RELEASE_BACKUP_RETENTION_DAYS=14
# 二选一：若未显式提供 RELEASE_RESTART_CMD，可用以下任一变量自动生成重启命令
# RELEASE_RESTART_CMD=pm2 restart purelyprofit-server && pm2 describe purelyprofit-server >/dev/null
# RELEASE_SYSTEMD_SERVICE_NAME=purelyprofit-server
# RELEASE_PM2_APP_NAME=purelyprofit-server
# RELEASE_LAUNCHD_SERVICE_NAME=com.purelyprofit.server
