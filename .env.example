# App
PORT=3000
NODE_ENV=development
APP_CORS_ORIGIN=*
APP_SWAGGER_ENABLED=true
APP_LOG_ENABLED=true
APP_SLOW_REQUEST_LOG_ENABLED=true
APP_SLOW_REQUEST_THRESHOLD_MS=800
APP_DEFAULT_PAGE_SIZE=20
APP_MAX_PAGE_SIZE=100

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/purelyprofit?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Auth
AUTH_PASSWORD_RESET_CODE_TTL_SECONDS=600
AUTH_REGISTER_CODE_TTL_SECONDS=600

# Pulse
PULSE_DEV_ACCOUNT_EMAILS=
