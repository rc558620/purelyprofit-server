# ─────────────────────────────────────────────────────────────────────────────
# purelyprofit-server 生产运行时环境文件模板
# ─────────────────────────────────────────────────────────────────────────────
# 目标路径：/etc/purelyprofit-server/production.env
#   sudo install -d -m 750 -o root -g purelyprofit /etc/purelyprofit-server
#   sudo install -m 640 -o root -g purelyprofit deploy/production.env.example \
#        /etc/purelyprofit-server/production.env
#   # 640 + 组 purelyprofit：systemd(root) 与「加入 purelyprofit 组的发布用户」都能读取，
#   # 发布脚本执行 prisma migrate deploy 时需要 DATABASE_URL
#   # 再逐项替换 <...> 占位符
#
# 微信支付私钥目录（与上面同一套权限约定）：
#   sudo install -d -m 750 -o root -g purelyprofit /etc/purelyprofit-server/certs
#   sudo install -m 640 -o root -g purelyprofit apiclient_key.pem /etc/purelyprofit-server/certs/
#
# 该文件是唯一的运行时配置来源：GitHub Actions 只负责把产物送到服务器，
# 不再注入业务变量，避免「CI 变量」与「服务器环境文件」两处配置漂移。
#
# 启动期会做生产配置校验（src/bootstrap/production-config.utils.ts），
# 下列标 ★ 的缺项或使用示例值会直接拒绝启动，属于「上线前必须补齐」清单。
# ─────────────────────────────────────────────────────────────────────────────

# ─── 基础 ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
TZ=Asia/Shanghai
APP_BUSINESS_TIMEZONE=Asia/Shanghai
# 与 deploy/systemd 中的 CLUSTER_WORKERS 保持一致，按 CPU 核数设置
CLUSTER_WORKERS=4

# ★ 生产环境必须是具体域名白名单，禁止 *；含 yourdomain.com 会被判为未配置
#   www 已在 Nginx 301 到根域，保留它以兼容历史书签
APP_CORS_ORIGIN=https://chunlibao.cn,https://www.chunlibao.cn,https://pulse.chunlibao.cn,https://club.chunlibao.cn
# ★ 生产必须关闭 Swagger
APP_SWAGGER_ENABLED=false
APP_PORT_AUTO_TERMINATE_ENABLED=false
APP_PORT_AUTO_SHIFT_ENABLED=false
APP_LOG_ENABLED=false

# ─── 数据库 ─────────────────────────────────────────────────────────────────
# ★ 必填
DATABASE_URL=postgresql://purelyprofit:<DB_PASSWORD>@127.0.0.1:5432/purelyprofit?schema=public
# 迁移漂移校验用的影子库（与主库同实例，仅本地/CI 校验需要）
SHADOW_DATABASE_URL=postgresql://purelyprofit:<DB_PASSWORD>@127.0.0.1:5432/purelyprofit_shadow?schema=public
DATABASE_POOL_MAX=20
DATABASE_POOL_MIN=5
DATABASE_STATEMENT_TIMEOUT_MS=10000

# ─── Redis ──────────────────────────────────────────────────────────────────
# ★ REDIS_HOST 必填；Redis 同时承载原生 WebSocket 广播与 Socket.IO adapter
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=<REDIS_PASSWORD>
REDIS_DB=0

# ─── JWT ────────────────────────────────────────────────────────────────────
# ★ 必填，禁止使用 secret；生成：openssl rand -base64 48
JWT_SECRET=<JWT_SECRET>
JWT_EXPIRES_IN=7d

# ─── 管理端登录 ─────────────────────────────────────────────────────────────
# ★ 不得使用默认值 admin / 13619654020，否则拒绝启动
AUTH_ADMIN_LOGIN_ALIAS=<ADMIN_LOGIN_ALIAS>
AUTH_ADMIN_LOGIN_PHONE=<ADMIN_LOGIN_PHONE>

# ─── 小程序与微信支付（平台直连链路）────────────────────────────────────────
# ★ WECHAT_APP_ID / WECHAT_APP_SECRET / WECHAT_MCH_SERIAL_NO 必填
WECHAT_APP_ID=wxb2533a73dc3764b5
WECHAT_APP_SECRET=<WECHAT_APP_SECRET>
WECHAT_MCH_SERIAL_NO=<WECHAT_MCH_CERT_SERIAL_NO>
# ★ 平台收款商户号与 APIv3 密钥（解密回调报文必需）
WECHAT_PAY_MCH_ID=<WECHAT_PAY_MCH_ID>
WECHAT_PAY_API_V3_KEY=<32位_APIv3_密钥>
# ★ 商户私钥二选一：PATH 需指向服务器上真实存在的文件
WECHAT_PRIVATE_KEY_PATH=/etc/purelyprofit-server/certs/apiclient_key.pem
# WECHAT_PRIVATE_KEY_CONTENT="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# ★ 微信支付平台证书公钥（回调 RSA 验签）
WECHAT_PLATFORM_PUBLIC_KEY_CONTENT="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# ★ 门店收款配置落库加密主密钥；轮换会导致历史密文解不开
WECHAT_PAY_KEY_ENCRYPTION_SECRET=<WECHAT_PAY_KEY_ENCRYPTION_SECRET>
# ★ 三条回调地址各用各的，禁止混用
WECHAT_PAY_NOTIFY_URL=https://api.chunlibao.cn/api/club/payments/wechat/callback
PROFIT_WECHAT_PAY_NOTIFY_URL=https://api.chunlibao.cn/api/profit/payments/wechat/callback
SMS_WECHAT_PAY_NOTIFY_URL=https://api.chunlibao.cn/api/marketing/sms/wechat/callback
# ★ 生产必须 false：true 时只校验时间戳，回调可被伪造
WECHAT_ALLOW_INSECURE_CALLBACK=false

# ─── 微信支付服务商（Partner）模式：C 端门店收款 ────────────────────────────
# 商家只提供子商户号，服务商持有证书与回调密钥。
# 开启后 appendWechatPartnerErrors 会额外校验以下全部字段，缺一项即拒绝启动。
# 未开通服务商前保持 false。
WECHAT_PARTNER_ENABLED=false
# WECHAT_PARTNER_SP_MCH_ID=<服务商商户号>
# sp_appid 必须是与服务商号同主体、已微信认证的 AppID
# WECHAT_PARTNER_SP_APP_ID=<服务商自有_已认证_AppID>
# sub_appid：当 purelyClub 小程序与服务商号不同主体时配置，留空则维持 sp_appid+sp_openid 口径
# WECHAT_PARTNER_SUB_APP_ID=wxb2533a73dc3764b5
# WECHAT_PARTNER_API_V3_KEY=<服务商_APIv3_密钥>
# WECHAT_PARTNER_MCH_SERIAL_NO=<服务商证书序列号>
# WECHAT_PARTNER_PRIVATE_KEY_PATH=/etc/purelyprofit-server/certs/partner_apiclient_key.pem
# WECHAT_PARTNER_PLATFORM_PUBLIC_KEY_CONTENT="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# 必须以 /api/club/payments/wechat/callback 结尾
# WECHAT_PARTNER_PAY_NOTIFY_URL=https://api.chunlibao.cn/api/club/payments/wechat/callback
# 服务商与平台收款商户号同号时必须显式豁免并留档原因
# WECHAT_PARTNER_ALLOW_SHARED_PLATFORM_MCH_ID=false
# WECHAT_PARTNER_SHARED_MCH_ID_REASON=

# ─── 支付模式开关：生产必须全部关闭（启动校验会拦）──────────────────────────
CLUB_MANUAL_CONFIRM_PAID_ENABLED=false
CLUB_PAYMENT_MODE_SWITCH_ENABLED=false
PROFIT_MANUAL_PAID_ENABLED=false
PROFIT_PAYMENT_MODE_SWITCH_ENABLED=false

# ─── 扫码点餐 / 邀请二维码：域名属永久资产，只增不换 ────────────────────────
# 邀请二维码形如 {CLUB_PUBLIC_BASE_URL}/i/v1/{inviteCode}
CLUB_PUBLIC_BASE_URL=https://club.chunlibao.cn
CLUB_STORE_INVITE_QR_ENTRY_PATH=/i
# 桌码 {SCAN_QR_BASE_URL}/t/{token}、空间码 /p/{token}
# ⚠ 必须与 CLUB_PUBLIC_BASE_URL 分域，否则微信「扫普通链接二维码」规则会把邀请码一并
#   唤起小程序，导致邀请页无法落地
SCAN_QR_BASE_URL=https://scan.chunlibao.cn
# 空间码 token 加密密钥（32 字节 Base64）；缺失时由 JWT_SECRET 派生，轮换 JWT 会失效
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# 轮换时旧值填 SPACE_QR_TOKEN_ENCRYPTION_KEY_PREVIOUS，历史空间码仍可解出
SPACE_QR_TOKEN_ENCRYPTION_KEY=<SPACE_QR_TOKEN_ENCRYPTION_KEY>

# ─── 腾讯云短信（未配置时短信相关接口报错，但不阻塞启动）────────────────────
TENCENT_SMS_SECRET_ID=<TENCENT_SMS_SECRET_ID>
TENCENT_SMS_SECRET_KEY=<TENCENT_SMS_SECRET_KEY>
TENCENT_SMS_SDK_APP_ID=<TENCENT_SMS_SDK_APP_ID>
TENCENT_SMS_SIGN_NAME=<短信签名>
TENCENT_SMS_REGISTER_TEMPLATE_ID=<注册模板ID>
TENCENT_SMS_LOGIN_TEMPLATE_ID=<登录模板ID>

# ─── 腾讯云 COS 对象存储 ────────────────────────────────────────────────────
TENCENT_COS_SECRET_ID=<TENCENT_COS_SECRET_ID>
TENCENT_COS_SECRET_KEY=<TENCENT_COS_SECRET_KEY>
TENCENT_COS_REGION=<ap-shanghai>
TENCENT_COS_BUCKET=<bucket-name-appid>
TENCENT_COS_CDN_DOMAIN=https://cdn.chunlibao.cn
TENCENT_COS_PATH_PREFIX=uploads/

# ─── 可观测性（按需调整）────────────────────────────────────────────────────
APP_SLOW_REQUEST_LOG_ENABLED=true
APP_SLOW_REQUEST_THRESHOLD_MS=800
APP_SLOW_QUERY_LOG_ENABLED=true
APP_SLOW_QUERY_THRESHOLD_MS=80
APP_SLOW_REDIS_LOG_ENABLED=true
APP_SLOW_REDIS_THRESHOLD_MS=20
APP_SQL_METRICS_ENABLED=true
APP_CACHE_PREWARM_ENABLED=true
APP_SPACE_AUTO_CHECKOUT_ENABLED=true
